#!/usr/bin/env bash
# reset: factory-reset a router (factoryreset) and wait for it to come back
# parameters via env: IP_BEFORE IP_AFTER
set -Eeuo pipefail; shopt -s inherit_errexit

: "${IP_BEFORE:?IP_BEFORE not set}"
: "${IP_AFTER:?IP_AFTER not set}"
[ $# -ge 1 ] || { echo "usage: reset <ssh-target>" >&2; exit 2; }
HOST=$1

KH=$(mktemp)
trap 'rm -f "$KH"' EXIT

echo "factory-resetting $HOST..."
ssh-keyscan "$HOST" > "$KH" 2>/dev/null || :
timeout 30 ssh -o UserKnownHostsFile="$KH" \
    "root@$HOST" '/sbin/factoryreset -yr' ||:

echo 'waiting 30s for the reboot, enjoy the blinking...'
sleep 30
echo "waiting for $HOST to come back at $IP_AFTER ..."
for _ in $(seq 30); do
    ping -q -c1 -W2 "$IP_AFTER" &>/dev/null && break
    sleep 5
done
ping -q -c1 -W2 "$IP_AFTER" >/dev/null \
    || { echo "no node at $IP_AFTER after reset" >&2; exit 1; }
echo "$HOST is factory-reset and back at $IP_AFTER"
