#!/usr/bin/env python3
# decrypt-ssh-key: write /tmp/secrets/sshd in dropbear format
# parameters come from /usr/mtd.layout
# the blob[32:64] seed is the ed25519 key
# dropbear wants it as "ssh-ed25519" + seed + pubkey

import os
import struct

from cryptography.hazmat.primitives.asymmetric import ed25519
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

layout = {}
for line in open('/usr/mtd.layout'):
    line = line.split('#', 1)[0].strip()
    if line and '=' in line:
        k, v = line.split('=', 1)
        layout[k] = v.strip()
mtd = layout['RNDMTD']
rndlen = int(layout['RNDLEN'], 0)
rndoff = int(layout['RNDOFF'], 0)
assert rndoff % rndlen == 0, 'offset not a multiple of the block size'
blob = open(f'/dev/{mtd}', 'rb').read()[rndoff:rndoff + rndlen]

seed = blob[32:64]
w = bin(int.from_bytes(seed, 'big')).count('1')
assert -24 < w - 128 < 24, f'ssh seed hamming weight {w} is sus'
pub = ed25519.Ed25519PrivateKey.from_private_bytes(seed).public_key()
pub_raw = pub.public_bytes(Encoding.Raw, PublicFormat.Raw)

key = (struct.pack('>I', 11) + b'ssh-ed25519' +
       struct.pack('>I', 64) + seed + pub_raw)
os.makedirs('/tmp/secrets', exist_ok=True)
with open('/tmp/secrets/sshd', 'wb') as f:
    f.write(key)
