#!/usr/bin/env bash
# flash-randomness: flash a block of randomness into a router's vendor mtd
#   usage: flash-randomness <ssh-target> <name>
# it should not leave the device as it's used as privkeys; see derive-pubkeys
#
# parameters come from openwrt/routers/<name>/{mtd.layout,fingerprint}

set -Eeuo pipefail; shopt -s inherit_errexit

HOST=$1
NAME=$2
LAYOUT="$(dirname "$0")/../routers/$NAME/mtd.layout"
FPFILE="$(dirname "$0")/../routers/$NAME/fingerprint"
[ -r "$LAYOUT" ] || { echo 2>&1 "no $LAYOUT"; exit 1; }
[ -r "$FPFILE" ] || { echo 2>&1 "no $FPFILE"; exit 1; }
FINGERPRINT=$(cat "$FPFILE")
. "$LAYOUT"

ssh "root@$HOST" \
    "FPEXP=$FINGERPRINT RNDMTD=$RNDMTD FPMTD=$FPMTD RNDLEN=$RNDLEN \
     RNDOFF=$RNDOFF FPLEN=$FPLEN FPOFF=$(( FPOFF )) sh -s" <<'EOF'
set -eu

command -v openssl >/dev/null || { echo 2>&1 'openssl missing'; exit 1; }
ls /lib/modules/*/mtd-rw.ko >/dev/null 2>&1 \
  || { echo 2>&1 'kmod-mtd-rw not installed'; exit 1; }

# check: serial matches (protection from running on wrong device)
fp=$(dd if=/dev/$FPMTD bs=1 skip=$FPOFF count=$FPLEN | tr -d '\000\377')
[ "$fp" = "$FPEXP" ] || { echo 2>&1 "serial $fp != $FPEXP"; exit 1; }
# check: erasesize matches the name's layout
rndlen=$(grep "^$RNDMTD:" /proc/mtd | cut -d' ' -f3)
[ $(( 0x$rndlen )) -eq $(( RNDLEN )) ] \
  || { echo 2>&1 "erasesize $rndlen != $RNDLEN"; exit 1; }
# geometry is bytes; BusyBox dd takes no hex, so hand it decimals
BS=$(( RNDLEN ))
SKIP=$(( RNDOFF / RNDLEN ))
[ $(( RNDOFF % RNDLEN )) -eq 0 ] \
  || { echo 2>&1 'offset not a multiple of the block size'; exit 1; }
# check: randomness hasn't been written yet
dd if=/dev/$RNDMTD bs=$BS skip=$SKIP count=1 2>/dev/null > /tmp/.kchk
dd if=/dev/zero bs=$BS count=1 2>/dev/null | tr '\000' '\377' > /tmp/.fs
cmp -s /tmp/.kchk /tmp/.fs || { echo 2>&1 'already written'; exit 1; }
echo >&2 'checks passed'

# generate randomness
dd if=/dev/urandom bs=$BS count=1 2>/dev/null > /tmp/.kblob
dd if=/dev/zero bs=$BS count=1 2>/dev/null > /tmp/.0s
# check it's at least a little random (derive-pubkeys does more)
! cmp -s /tmp/.kblob /tmp/.0s || { echo 2>&1 'rng all zeros'; exit 1; }
head -c 32 /dev/zero > /tmp/.32x0
head -c 32 /dev/zero | tr '\000' '\377' > /tmp/.32xff
head -c 32 /tmp/.kblob > /tmp/.key1
cmp -s /tmp/.key1 /tmp/.32x0 && { echo 2>&1 'age seed all zeros'; exit 1; }
cmp -s /tmp/.key1 /tmp/.32xff && { echo 2>&1 'age seed all ff'; exit 1; }
dd if=/tmp/.kblob bs=1 skip=32 count=32 2>/dev/null > /tmp/.key2
cmp -s /tmp/.key2 /tmp/.32x0 && { echo 2>&1 'ssh seed all zeros'; exit 1; }
cmp -s /tmp/.key2 /tmp/.32xff && { echo 2>&1 'ssh seed all ff'; exit 1; }
dd if=/tmp/.kblob bs=1 skip=64 count=32 2>/dev/null > /tmp/.key3
cmp -s /tmp/.key3 /tmp/.32x0 && { echo 2>&1 'wg seed all zeros'; exit 1; }
cmp -s /tmp/.key3 /tmp/.32xff && { echo 2>&1 'wg seed all ff'; exit 1; }
rm -f /tmp/.kchk /tmp/.fs /tmp/.0s /tmp/.32x0 /tmp/.32xff \
      /tmp/.key1 /tmp/.key2 /tmp/.key3

# vendor partitions are flagged read-only in the DTS, kmod-mtd-rw clears it
flags=$(cat /sys/class/mtd/$RNDMTD/flags)
if [ $(( flags & 0x400 )) -eq 0 ]; then  # 0x400 = MTD_WRITEABLE
    insmod mtd-rw i_want_a_brick=1
    flags=$(cat /sys/class/mtd/$RNDMTD/flags)
    [ $(( flags & 0x400 )) -ne 0 ] || { echo 2>&1 'mtd-rw failed'; exit 1; }
fi

# flash randomness, verify back
mtd unlock /dev/$RNDMTD
mtd -q -p $(( RNDOFF )) write /tmp/.kblob /dev/$RNDMTD
dd if=/dev/$RNDMTD bs=$BS skip=$SKIP count=1 2>/dev/null > /tmp/.kver
cmp -s /tmp/.kblob /tmp/.kver || { echo 2>&1 'read-back mismatch'; exit 1; }
rm -f /tmp/.kblob /tmp/.kver
echo >&2 'flashed'
EOF
