#!/usr/bin/env python3
# decrypt: decrypt an age-encryped file with this device's key
#   usage: decrypt <seal-file> [out-file]
# parameters come from /usr/mtd.layout
# the blob[0:32] seed is the x25519 key for the secrets

import sys
sys.path.insert(0, '/usr/local/python-modules')
import age

layout = {}
with open('/usr/mtd.layout') as f:
    for line in f:
        line = line.split('#', 1)[0].strip()
        if line and '=' in line:
            k, v = line.split('=', 1)
            layout[k] = v.strip()
mtd = layout['RNDMTD']
rndlen = int(layout['RNDLEN'], 0)
rndoff = int(layout['RNDOFF'], 0)
assert rndoff % rndlen == 0, 'offset not a multiple of the block size'
with open(f'/dev/{mtd}', 'rb') as f:
    blob = f.read()[rndoff:rndoff + rndlen]

ident = age.X25519Identity(blob[0:32])
with open(sys.argv[1], 'rb') as f:
    pt = age.decrypt_bytes(f.read(), [ident])
if len(sys.argv) > 2:
    with open(sys.argv[2], 'wb') as f:
        f.write(pt)
else:
    sys.stdout.buffer.write(pt)
