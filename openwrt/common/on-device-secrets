#!/usr/bin/env python3
# on-device-secrets: the router-side on-device secrets handling
#   subcommands:
#     wipe                          erase the randomness block
#     flash-randomness <expected>   flash a fresh randomness block into the mtd
#     derive-pubkeys                print the pubkey trio from the flashed blob
#     install-ssh-key               write /tmp/secrets/sshd in dropbear format
#     decrypt <seal>                 decrypt an age file with the device's key

# parameters come from /usr/mtd.layout
# blob layout: [0:32] secrets x25519, [32:64] ssh ed25519, [64:96] wireguard

import base64
import os
import shutil
import struct
import subprocess
import sys

from cryptography.hazmat.primitives.asymmetric import ed25519, x25519
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

sys.path.insert(0, '/usr/local/python-modules')
import age

RNDMTD = RNDLEN = RNDOFF = FPMTD = FPLEN = FPOFF = None
with open('/usr/mtd.layout') as f:
    for line in f:
        line = line.split('#', 1)[0].strip()
        if line and '=' in line:
            k, v = line.split('=', 1)
            globals()[k] = v.strip()
RNDLEN, RNDOFF, FPLEN, FPOFF = (int(v, 0)
                                for v in (RNDLEN, RNDOFF, FPLEN, FPOFF))
assert RNDOFF % RNDLEN == 0, 'offset not a multiple of the block size'

# OpenSSH wire-format tag: string "ssh-ed25519" (length prefix + name)
SSH_ED25519 = struct.pack('>I', 11) + b'ssh-ed25519'


def read_blob():
    with open(f'/dev/{RNDMTD}', 'rb') as f:
        return f.read()[RNDOFF:RNDOFF + RNDLEN]


def check_hamming_weight(kind, seed):
    w = int.from_bytes(seed, 'big').bit_count()
    assert -24 < w - 128 < 24, f'{kind} seed hamming weight {w} is sus'


def mtd_writable():
    # vendor partitions are read-only in the DTS; kmod-mtd-rw clears it
    with open(f'/sys/class/mtd/{RNDMTD}/flags') as f:
        flags = int(f.read(), 0)
    if flags & 0x400 == 0:  # 0x400 = MTD_WRITEABLE
        r = subprocess.run(['insmod', 'mtd-rw', 'i_want_a_brick=1'],
                           check=False)
        assert r.returncode == 0, \
            "can't load mtd-rw; install: apk add kmod-mtd-rw mtd"
        with open(f'/sys/class/mtd/{RNDMTD}/flags') as f:
            flags = int(f.read(), 0)
    assert flags & 0x400, 'mtd-rw failed'


def check_erasesize():
    # the mtd's erasesize must match the layout's RNDLEN
    erasesize = None
    with open('/proc/mtd') as f:
        for line in f:
            parts = line.split()
            if parts and parts[0].rstrip(':') == RNDMTD:
                erasesize = int(parts[2], 16)
                break
    assert erasesize == RNDLEN, \
        f'erasesize {erasesize} != {RNDLEN} for {RNDMTD}'


def mtd_write_bytes(data):
    # write a block to the mtd; needs mtd + kmod-mtd-rw
    assert shutil.which('mtd'), \
        'write needs mtd; install: apk add mtd kmod-mtd-rw'
    check_erasesize()
    tmp = f'/tmp/.kblob-{os.getpid()}'
    with open(tmp, 'wb') as f:
        f.write(data)
    mtd_writable()
    subprocess.run(['mtd', 'unlock', f'/dev/{RNDMTD}'], check=True)
    subprocess.run(['mtd', '-q', '-p', str(RNDOFF), 'write', tmp,
                    f'/dev/{RNDMTD}'], check=True)
    os.unlink(tmp)


def cmd_wipe(args):
    mtd_write_bytes(b'\xff' * RNDLEN)
    print('wiped', file=sys.stderr)


def cmd_flash_randomness(args):
    # wrong-device guard: refuse unless the serial matches the expected one
    assert args, 'usage: on-device-secrets flash-randomness <expected-serial>'
    with open(f'/dev/{FPMTD}', 'rb') as f:
        fp = f.read()[FPOFF:FPOFF + FPLEN]
    fp = fp.replace(b'\x00', b'').replace(b'\xff', b'').decode()
    assert fp == args[0], f'serial {fp} != {args[0]}'
    # check: randomness hasn't been written yet
    assert read_blob() == b'\xff' * RNDLEN, 'already written'
    # generate randomness and sanity-check the three seeds
    blob = os.urandom(RNDLEN)
    assert blob != b'\x00' * RNDLEN, 'rng all zeros'
    for i, kind in enumerate(('age', 'ssh', 'wg')):
        seed = blob[i * 32:(i + 1) * 32]
        assert seed not in (b'\x00' * 32, b'\xff' * 32), \
            f'{kind} seed is all zeros or all ff'
    mtd_write_bytes(blob)
    assert read_blob() == blob, 'read-back mismatch'
    print('flashed', file=sys.stderr)


def cmd_derive_pubkeys(args):
    blob = read_blob()
    for kind, seed in (('secrets', blob[0:32]), ('ssh', blob[32:64]),
                      ('wireguard', blob[64:96])):
        check_hamming_weight(kind, seed)

    def x25519_pub(seed):
        priv = x25519.X25519PrivateKey.from_private_bytes(seed)
        return priv.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)

    age_pub = age.X25519Recipient(x25519_pub(blob[0:32]))
    ssh_pub = ed25519.Ed25519PrivateKey.from_private_bytes(
        blob[32:64]).public_key()
    ssh_raw = ssh_pub.public_bytes(Encoding.Raw, PublicFormat.Raw)
    # OpenSSH wire format: string "ssh-ed25519" + string <raw 32-byte pubkey>
    ssh = SSH_ED25519 + struct.pack('>I', 32) + ssh_raw
    print('AGE_PUB', age_pub)
    print('SSH_PUB', base64.b64encode(ssh).decode())
    print('WG_PUB', base64.b64encode(x25519_pub(blob[64:96])).decode())


def cmd_install_ssh_key(args):
    seed = read_blob()[32:64]
    check_hamming_weight('ssh', seed)
    pub_raw = ed25519.Ed25519PrivateKey.from_private_bytes(
        seed).public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
    key = SSH_ED25519 + struct.pack('>I', 64) + seed + pub_raw
    os.makedirs('/tmp/secrets', exist_ok=True)
    with open('/tmp/secrets/sshd', 'wb') as f:
        f.write(key)


def cmd_decrypt(args):
    assert args, 'usage: on-device-secrets decrypt <seal-file>'
    ident = age.X25519Identity(read_blob()[0:32])
    with open(args[0], 'rb') as f:
        sys.stdout.buffer.write(age.decrypt_bytes(f.read(), [ident]))


def usage():
    # the header above is the usage; print it (minus the shebang)
    with open(__file__) as f:
        for line in f:
            if line.startswith('#!'):
                continue
            if not line.startswith('#'):
                break
            print(line[2:].rstrip(), file=sys.stderr)
    sys.exit(1)


def main():
    if len(sys.argv) < 2:
        usage()
    cmd, args = sys.argv[1], sys.argv[2:]
    fn = globals().get('cmd_' + cmd.replace('-', '_'))
    assert fn, f'unknown subcommand {cmd!r}'
    fn(args)


if __name__ == '__main__':
    main()
