#!/usr/bin/env bash
set -ueo pipefail

HOSTNAME=$1
REACH_VIA=$2
INT_IP=$3
INT_NET=192.168.99.0

YQ=$(nix build --print-out-paths --no-link 'nixpkgs#yq-go') || exit $?
NEBULA=$(nix build --print-out-paths --no-link 'nixpkgs#nebula')
toml_put() { local file=$1 key=$2 val=$3
    local tmp; tmp=$(mktemp)
    KEY="$key" VAL="$val" "$YQ/bin/yq" -p toml -o toml \
        '.[env(KEY)] = env(VAL)' < "$file" > "$tmp"
    mv "$tmp" "$file"
}

trap 'rm -rf /tmp/.nebula' EXIT
mkdir -p /tmp/.nebula

pass show services/unboiled.info/nebula > /tmp/.nebula/ca.key

"$NEBULA/bin/nebula-cert" sign \
	-name "$HOSTNAME" \
	-ip "$INT_IP/24" \
	-subnets "$INT_NET/24" \
	-ca-key "/tmp/.nebula/ca.key" \
	-ca-crt ~/.nix-configs/nixos/services/nebula/ca \
	-out-key "/tmp/.nebula/$HOSTNAME.key" \
	-out-crt "/tmp/.nebula/$HOSTNAME.crt"

TGT=$(mktemp)
scp "/tmp/.nebula/$HOSTNAME.key" "$REACH_VIA:$TGT"

REACH_VIA=${REACH_VIA#[}
REACH_VIA=${REACH_VIA%]}
ssh "$REACH_VIA" bash -ueo pipefail -s <<EOF
trap 'rm -f "$TGT"' EXIT
if [[ -e /mnt/persist/secrets/nebula ]]; then
	id nebula-unboiled >/dev/null && USR=nebula-unboiled || USR=root
	sudo install -o\$USR -groot -m700 -d /mnt/persist/secrets/nebula
	sudo install -o\$USR -groot -m600 \
		"$TGT" "/mnt/persist/secrets/nebula/$HOSTNAME"
else
	sudo install -oroot -groot -m600 "$TGT" "/mnt/secrets/nebula"
fi
EOF

pub=$(< "/tmp/.nebula/$HOSTNAME.crt" \
	  grep -vFx -- '-----BEGIN NEBULA CERTIFICATE V2-----' \
	| grep -vFx -- '-----END NEBULA CERTIFICATE V2-----' \
	| tr -d '\n')
toml_put misc/pubkeys/nebula.toml "$HOSTNAME" "$pub"
rm -f "/tmp/.nebula/$HOSTNAME.key"

echo -n "add something like \`$HOSTNAME = "
echo "{ int = \"$INT_IP\"; ext = [\"$REACH_VIA\"]; };\`"
echo 'to ~/.nix-configs/nixos/services/nebula/default.nix'
echo 'and import ../../nixos/services/nebula from host configuration: '
