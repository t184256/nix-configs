-
-        return { lines = parsed_lines, cursor = inferred }, nil
+        return result, nil
 
     elseif cursor_marker_count > 1 then
         return nil, 'expected exactly one cursor marker inside editable region: ' .. text
@@ -333,6 +343,26 @@ function M.parse_duet_response(text, context)
     local cursor_offset = #before
     local text_without_cursor = before .. after
 
+    -- HACK: model often puts cursor at the very end of the suggestion,
+    -- which is patently useless; ignore when
+    -- the output has more lines than editable_region.lines_after / 2.
+    local cursor_at_end = (cursor_offset == #text_without_cursor)
+    if cursor_at_end then
+        local config = M.get_config() or {}
+        local editable_region = config.editable_region or {}
+        local lines_after = editable_region.lines_after or 15
+        local output_lines = vim.split(text_without_cursor, '\n', { plain = true })
