+        run = function()
+            helpers.setup_root_config {}
+            local utils = helpers.reload 'minuet.duet.utils'
+            -- "игла" (needle) -> "стог" (stack): no common prefix or suffix
+            local p, o, s = utils.inline_diff('игла', 'стог')
+            helpers.expect_equal(p, 0)
+            helpers.expect_equal(o, 8)
+            helpers.expect_equal(s, 8)
+        end,
+    },
+    {
+        name = 'duet.utils.inline_diff multi-byte mismatch',
+        run = function()
+            helpers.setup_root_config {}
+            local utils = helpers.reload 'minuet.duet.utils'
+            -- "ура" / "фураж": no common prefix or suffix
+            local p, o, s = utils.inline_diff('ура', 'фураж')
+            helpers.expect_equal(p, 0)
+            helpers.expect_equal(o, 6)
