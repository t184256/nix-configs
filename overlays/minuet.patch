From f96e4149395b87f9ad1b3486deabcc119c194c66 Mon Sep 17 00:00:00 2001
From: Alexander Sosedkin <monk@unboiled.info>
Date: Thu, 25 Jun 2026 18:54:14 +0200
Subject: [PATCH 03/13] duet.utils: implement and test inline_diff

---
 lua/minuet/duet/utils.lua |  66 ++++++++++++
 tests/duet_utils_spec.lua | 218 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 284 insertions(+)

diff --git a/lua/minuet/duet/utils.lua b/lua/minuet/duet/utils.lua
index 3332ada..aeff7de 100644
--- a/lua/minuet/duet/utils.lua
+++ b/lua/minuet/duet/utils.lua
@@ -311,4 +311,70 @@ function M.parse_duet_response(text, context)
         nil
 end
 
+--- Compute the number of common characters at the start of two strings.
+--- Walks character-by-character (handling multi-byte correctly).
+---@param a string
+---@param b string
+---@param a_len? integer optional pre-computed vim.fn.strchars(a)
+---@param b_len? integer optional pre-computed vim.fn.strchars(b)
+---@return integer number of common prefix characters
+function M.common_prefix_len(a, b, a_len, b_len)
+    a_len = a_len or vim.fn.strchars(a)
+    b_len = b_len or vim.fn.strchars(b)
+    local chars = 0
+    while chars < a_len and chars < b_len do
+        if vim.fn.strcharpart(a, chars, 1) ~=
+           vim.fn.strcharpart(b, chars, 1) then
+            break
+        end
+        chars = chars + 1
+    end
+    return chars
+end
+
+--- Compute the number of common characters at the end of two strings.
+--- Walks backwards character-by-character (handling multi-byte correctly).
+---@param a string
+---@param b string
+---@param a_len? integer optional pre-computed vim.fn.strchars(a)
+---@param b_len? integer optional pre-computed vim.fn.strchars(b)
+---@return integer number of common suffix characters
+function M.common_suffix_len(a, b, a_len, b_len)
+    a_len = a_len or vim.fn.strchars(a)
+    b_len = b_len or vim.fn.strchars(b)
+    local chars = 0
+    while chars < a_len and chars < b_len do
+        if vim.fn.strcharpart(a, a_len - chars - 1, 1) ~=
+           vim.fn.strcharpart(b, b_len - chars - 1, 1) then
+            break
+        end
+        chars = chars + 1
+    end
+    return chars
+end
+
+--- Compute character-granular inline diff between two strings.
+--- Return (prefix_bytes, orig_changed_bytes, sugg_changed_bytes) or nil
+--- when the strings are identical.
+---@param orig string original text
+---@param sugg string suggested text
+---@return integer|nil, integer|nil, integer|nil
+function M.inline_diff(orig, sugg)
+    if orig == sugg then return nil end
+    local orig_chars = vim.fn.strchars(orig)
+    local sugg_chars = vim.fn.strchars(sugg)
+    local prefix_chars = M.common_prefix_len(orig, sugg, orig_chars, sugg_chars)
+    local prefix_bytes = #vim.fn.strcharpart(orig, 0, prefix_chars)
+    local suffix_chars = M.common_suffix_len(orig, sugg, orig_chars, sugg_chars)
+    -- prevent prefix and suffix from overlapping on the shorter string
+    if prefix_chars + suffix_chars > math.min(orig_chars, sugg_chars) then
+        suffix_chars = math.min(orig_chars, sugg_chars) - prefix_chars
+    end
+    local suffix_bytes = #vim.fn.strcharpart(orig, orig_chars - suffix_chars,
+                                             suffix_chars)
+    return prefix_bytes,
+           #orig - prefix_bytes - suffix_bytes,
+           #sugg - prefix_bytes - suffix_bytes
+end
+
 return M
diff --git a/tests/duet_utils_spec.lua b/tests/duet_utils_spec.lua
index 1a855a7..c1acf30 100644
--- a/tests/duet_utils_spec.lua
+++ b/tests/duet_utils_spec.lua
@@ -222,4 +222,222 @@ f<cursor_position/>o<cursor_position/>o
             helpers.expect_match(err, 'cursor marker')
