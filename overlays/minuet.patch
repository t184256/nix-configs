diff --git a/lua/minuet/duet/utils.lua b/lua/minuet/duet/utils.lua
index aeff7de..99526ef 100644
--- a/lua/minuet/duet/utils.lua
+++ b/lua/minuet/duet/utils.lua
@@ -165,7 +165,7 @@ end
 
 ---@class minuet.DuetParseResult
 ---@field lines string[]
----@field cursor minuet.DuetParseCursor
+---@field cursor minuet.DuetParseCursor?
 
 ---@class minuet.DuetFilterContext
 ---@field non_editable_region_before? string
@@ -173,6 +173,35 @@ end
 
 ---@alias minuet.DuetParseContext minuet.DuetFilterContext|minuet.DuetContext
 
+--- Try to infer cursor position from edits. Returns {row_offset, col} of the last
+--- edited byte across all changed lines, or nil if no edits were detected.
+--- Uses inline_diff to find prefix/suffix boundaries, placing cursor at the
+--- end of the changed region (after orig replacement, before common suffix).
+---@param original_lines string[]
+---@param proposed_lines string[]
+---@return minuet.DuetParseCursor?
+local function infer_cursor_from_edits(original_lines, proposed_lines)
+    local last_row = nil
+    local last_col = nil
+
+    for i = 1, math.max(#original_lines, #proposed_lines) do
+        local prefix, _, sugg_len = M.inline_diff(original_lines[i] or '', proposed_lines[i] or '')
+        if prefix then
+            -- cursor at end of edit: prefix + changed portion (excludes common suffix)
+            last_row = i - 1 -- 0-based
+            last_col = prefix + sugg_len
+        end
+    end
+
+    if last_row == nil then
+        return nil
+    end
+
+    local sugg_line = proposed_lines[last_row + 1] or ''
+    return { row_offset = last_row, col = math.min(last_col, #sugg_line) }
+end
+
+
 ---Trim duplicated non-editable text from the start of the editable response.
 ---The boolean return is true only when duplicated left context was removed;
 ---callers use it to decide whether a left boundary newline was only a separator.
@@ -264,12 +293,36 @@ function M.parse_duet_response(text, context)
 
     local cursor_marker_count = count_occurrences(inner, markers.cursor_position)
     if cursor_marker_count == 0 then
-        M.notify(
-            'Minuet duet response did not include a cursor marker; placing the cursor at the end of the editable region.',
-            'verbose',
-            vim.log.levels.INFO
-        )
-        inner = inner .. markers.cursor_position
+        -- No cursor marker: try to infer from edits
+        local trimmed_right
+        inner, trimmed_right = trim_inner_right(inner, context)
+        if trimmed_right then
+            inner = trim_boundary_newlines(inner, 'right')
+        end
+        local parsed_lines = vim.split(inner, '\n', { plain = true })
+        if #parsed_lines == 0 then parsed_lines = { '' } end
+
+        local inferred = nil
+        if type(context) == 'table' and type(context.original_lines) == 'table' then
+            inferred = infer_cursor_from_edits(context.original_lines, parsed_lines)
+        end
+
+        if inferred then
+            M.notify(
+                'Minuet duet response did not include a cursor marker; inferring position from edits.',
+                'verbose',
+                vim.log.levels.INFO
+            )
+        else
+            M.notify(
+                'Minuet duet response did not include a cursor marker; no edits detected, skipping preview.',
+                'verbose',
+                vim.log.levels.INFO
+            )
+        end
+
+        return { lines = parsed_lines, cursor = inferred }, nil
+
     elseif cursor_marker_count > 1 then
         return nil, 'expected exactly one cursor marker inside editable region: ' .. text
     end
