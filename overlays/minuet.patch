+++ b/lua/minuet/duet/utils.lua
@@ -259,6 +259,29 @@ local function trim_inner_right(inner, context)
     return inner, false
 end
 
+--- Shared fallback: trim right, split into lines, infer cursor from edits.
+--- Returns {lines, cursor} or {lines, cursor=nil} if no edits were detected.
+---@param text string
+---@param context minuet.DuetParseContext?
+---@return minuet.DuetParseResult
+local function parse_without_cursor(text, context)
+    local trimmed_right
+    text, trimmed_right = trim_inner_right(text, context)
+    if trimmed_right then
+        text = trim_boundary_newlines(text, 'right')
+    end
+    local parsed_lines = vim.split(text, '\n', { plain = true })
+    if #parsed_lines == 0 then parsed_lines = { '' } end
+
+    local inferred = nil
+    if type(context) == 'table' and type(context.original_lines) == 'table' then
+        inferred = infer_cursor_from_edits(context.original_lines, parsed_lines)
+    end
+
+    return { lines = parsed_lines, cursor = inferred }
+end
+M._parse_without_cursor = parse_without_cursor
+
