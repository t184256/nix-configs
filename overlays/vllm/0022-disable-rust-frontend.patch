From d9ae7a70d2cbe029aa10c06d8ad241adee0a8a3f Mon Sep 17 00:00:00 2001
From: Alexander Sosedkin <monk@unboiled.info>
Date: Sat, 13 Jun 2026 01:54:22 +0000
Subject: [PATCH] Disable Rust frontend - not needed for Nix builds

---
 pyproject.toml |  1 -
 setup.py       | 11 +++++++++--
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index faba7f3df..7b38dd49f 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -6,7 +6,6 @@ requires = [
     "packaging>=24.2",
     "setuptools>=77.0.3,<81.0.0",
     "setuptools-scm>=8.0",
-    "setuptools-rust>=1.9.0",
     "torch == 2.11.0",
     "wheel",
     "jinja2",
diff --git a/setup.py b/setup.py
index a95ee3451..c28cc7065 100644
--- a/setup.py
+++ b/setup.py
@@ -18,8 +18,15 @@ import torch
 from packaging.version import Version, parse
 from setuptools import Extension, setup
 from setuptools.command.build_ext import build_ext
-from setuptools_rust import Binding, RustExtension
-from setuptools_rust.build import build_rust
+# Rust frontend disabled for Nix builds
+# from setuptools_rust import Binding, RustExtension
+# from setuptools_rust.build import build_rust
+class Binding:
+    Exec = "bin"
+class RustExtension:
+    def __init__(self, *args, **kwargs): pass
+class build_rust:
+    pass
 from setuptools_scm import get_version
 from torch.utils.cpp_extension import CUDA_HOME, ROCM_HOME
 
-- 
2.54.0

