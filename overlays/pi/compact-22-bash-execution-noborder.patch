 		// Get the lines to potentially display (after context truncation)
-		const availableLines = contextTruncation.content ? contextTruncation.content.split("\n") : [];
+		const availableLines: string[] = contextTruncation.content ? contextTruncation.content.split("\n") : [];
+
+		// In terms of strings:
+		//   "" -> "[no output]"
+		//   "ab" -> "ab[no newline at the end of the output]"
+		//   "ab\n"  -> "ab"
+		//   "ab\n\n"-> "ab\n"
+		const hadTrailingNewline =
+			availableLines.length > 1 && availableLines[availableLines.length - 1] === "";
+		if (hadTrailingNewline) {
+			availableLines.pop();
+		}
+		let displayLines: string[];
+		if (availableLines.every((line) => line === "")) {
+			displayLines = [theme.fg("dim", "[no output]")];
+		} else if (!hadTrailingNewline) {
+			const last = availableLines.length - 1;
+			displayLines = [
+				...availableLines.slice(0, last),
+				availableLines[last] + theme.fg("dim", "[no newline at the end of the output]"),
+			];
+		} else {
+			displayLines = availableLines;
+		}
 
 		// Apply preview truncation based on expanded state
-		const previewLogicalLines = availableLines.slice(-PREVIEW_LINES);
-		const hiddenLineCount = availableLines.length - previewLogicalLines.length;
+		const previewLogicalLines = displayLines.slice(-PREVIEW_LINES);
+		const hiddenLineCount = displayLines.length - previewLogicalLines.length;
 
 		// Rebuild content container
 		this.contentContainer.clear();
