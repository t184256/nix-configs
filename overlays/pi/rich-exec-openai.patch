From 70d6fe175e3af5aca660d20d3f09b009c23899c9 Mon Sep 17 00:00:00 2001
From: Alexander Sosedkin <monk@unboiled.info>
Date: Thu, 8 Oct 2026 13:51:27 +0200
Subject: [PATCH] append exit code and duration metadata to tool results sent
 via OpenAI completions

---
 packages/ai/src/api/openai-completions.ts                 | 15 ++++++++++++++-
 .../ai/test/openai-completions-tool-result-images.test.ts |  2 +-
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/packages/ai/src/api/openai-completions.ts b/packages/ai/src/api/openai-completions.ts
index 0e5b606e..0eee5498 100644
--- a/packages/ai/src/api/openai-completions.ts
+++ b/packages/ai/src/api/openai-completions.ts
@@ -1175,6 +1175,19 @@ function addCacheControlToTextContent(
 	return false;
 }
 
+function formatToolResultDuration(ms: number): string {
+	return ms < 10_000 ? `${Math.round(ms)}ms` : `${Math.round(ms / 1000)}s`;
+}
+
+/** Append execution metadata (exit code / duration) to the tool results. */
+function formatToolResultMeta(msg: ToolResultMessage): string {
+	const exitCode = (msg.details as { exitCode?: number } | undefined)?.exitCode;
+	const status =
+		exitCode !== undefined ? `exited with code ${exitCode}` : msg.isError ? "failed" : "completed successfully";
+	const duration = msg.durationMs !== undefined ? ` in ${formatToolResultDuration(msg.durationMs)}` : "";
+	return `\n[${status}${duration}]`;
+}
+
 export function convertMessages(
 	model: Model<"openai-completions">,
 	context: TranscriptContext,
@@ -1412,7 +1425,7 @@ export function convertMessages(
 				// Some providers require the 'name' field in tool results
 				const toolResultMsg: ChatCompletionToolMessageParam = {
 					role: "tool",
-					content: sanitizeSurrogates(toolResultText),
+					content: sanitizeSurrogates(toolResultText + formatToolResultMeta(toolMsg)),
 					tool_call_id: toolMsg.toolCallId,
 				};
 				if (compat.requiresToolResultName && toolMsg.toolName) {
diff --git a/packages/ai/test/openai-completions-tool-result-images.test.ts b/packages/ai/test/openai-completions-tool-result-images.test.ts
index 7acc7221..7ff485c6 100644
--- a/packages/ai/test/openai-completions-tool-result-images.test.ts
+++ b/packages/ai/test/openai-completions-tool-result-images.test.ts
@@ -178,7 +178,7 @@ describe("openai-completions convertMessages", () => {
 			const messages = convertMessages(model, context, compat);
 			const toolMessage = messages.find((m) => m.role === "tool") as { role: "tool"; content: string } | undefined;
 			expect(toolMessage).toBeTruthy();
-			expect(toolMessage?.content).toBe("(no tool output)");
+			expect(toolMessage?.content).toBe("(no tool output)\n[completed successfully]");
 			expect(toolMessage?.content).not.toContain("see attached image");
 		},
 	);
-- 
2.55.0
