From 1ccc16d69344512de375558cdc821565810f674f Mon Sep 17 00:00:00 2001
From: Alexander Sosedkin <monk@unboiled.info>
Date: Thu, 8 Oct 2026 16:40:42 +0200
Subject: [PATCH] modes/interactive: tolerate abort-cascade errors in
 uncaughtCrash

---
 .../coding-agent/src/modes/interactive/interactive-mode.ts   | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/packages/coding-agent/src/modes/interactive/interactive-mode.ts b/packages/coding-agent/src/modes/interactive/interactive-mode.ts
index 55ea404..68badbe 100644
--- a/packages/coding-agent/src/modes/interactive/interactive-mode.ts
+++ b/packages/coding-agent/src/modes/interactive/interactive-mode.ts
@@ -4357,6 +4357,11 @@ export class InteractiveMode {
 		if (this.isShuttingDown) {
 			process.exit(1);
 		}
+		// Abort cascades (e.g. ESC while streaming) are not crashes.
+		const abortErr = error as { name?: string; message?: unknown } | null | undefined;
+		if (abortErr?.name === "AbortError" || /was aborted/i.test(String(abortErr?.message ?? ""))) {
+			return undefined as never;
+		}
 		this.isShuttingDown = true;
 		try {
 			this.unregisterSignalHandlers();
-- 
2.55.0

