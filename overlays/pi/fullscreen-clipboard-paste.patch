-export async function readClipboardText(): Promise<string | null> {
+/** Read plain text from the system clipboard (or primary selection). */
+export async function readClipboardText(target: ClipboardTarget = "c"): Promise<string | null> {
 	const commands: [string, string[]][] = [];
 	// Termux reports platform "android", not "linux" (#10391).
 	if (process.env.TERMUX_VERSION) commands.push(["termux-clipboard-get", []]);
 	if (platform() === "linux") {
-		if (process.env.WAYLAND_DISPLAY) commands.push(["wl-paste", ["--no-newline", "--type", "text"]]);
+		if (process.env.WAYLAND_DISPLAY) {
+			const args = ["--no-newline", "--type", "text"];
+			if (target === "s") args.push("--selection", "primary");
+			commands.push(["wl-paste", args]);
+		}
 		if (process.env.DISPLAY) {
-			commands.push(["xclip", ["-selection", "clipboard", "-out"]], ["xsel", ["--clipboard", "--output"]]);
+			const selection = target === "s" ? "primary" : "clipboard";
+			commands.push(
+				["xclip", ["-selection", selection, "-out"]],
+				target === "s" ? ["xsel", ["--primary", "--output"]] : ["xsel", ["--clipboard", "--output"]],
+			);
 		}
 	}
 	for (const [command, args] of commands) {
 		const bytes = await runClipboardCommand(command, args, { timeoutMs: 5000 });
 		if (bytes !== undefined) return bytes.toString("utf8") || null;
 	}
-	try {
-		return (await getNativeClipboard()?.getText()) || null;
-	} catch {
-		return null;
+
+	// The native addon only exposes the regular clipboard.
+	if (target === "c") {
+		try {
+			const text = await getNativeClipboard()?.getText();
+			if (text) return text;
+		} catch {
+			// Fall through to the terminal transport.
+		}
 	}
+
+	if (terminalClipboardReader) {
+		try {
+			const text = (await terminalClipboardReader(target)) || null;
+			return text;
+		} catch {
+			// Terminal transport is best-effort.
+		}
+	}
+
+	return null;
 }
 
