 			if (!handled) this.handleSelectionMouseEvent(mouseEvent);
@@ -721,6 +726,24 @@ export class TuiAltScreen extends TuiBase implements ViewportTUI {
 		};
 	}
 
+	/**
+	 * Middle-click paste. Terminals that would normally paste on middle-click
+	 * (Alacritty, ...) forward the button to us instead while fullscreen mouse
+	 * tracking is active, so we perform the paste ourselves.
+	 */
+	private handleMiddleClickPaste(event: SgrMouseEvent): boolean {
+		if (!this.onMiddleClickPaste || event.release || (event.button & 3) !== 1) {
+			return false;
+		}
+		try {
+			this.onMiddleClickPaste();
+			return true;
+		} catch {
+			// Clipboard paste is best-effort.
+			return false;
+		}
+	}
+
 	private handleRightClickPaste(event: SgrMouseEvent): boolean {
 		if (
 			!this.onRightClickPaste ||
@@ -1148,7 +1171,9 @@ export class TuiAltScreen extends TuiBase implements ViewportTUI {
 			this.flash(ok ? "Copied!" : "Copy failed");
 			return ok;
 		}
-		this.terminal.write(`\x1b]52;c;${Buffer.from(text).toString("base64")}\x07`);
+		// Selections go to the primary selection (OSC 52 target `s`), matching
+		// conventional terminal behavior and middle-click paste.
+		this.terminal.write(`\x1b]52;s;${Buffer.from(text).toString("base64")}\x07`);
 		this.flash("Copied!");
 		return true;
