diff --git a/packages/coding-agent/src/utils/clipboard.ts b/packages/coding-agent/src/utils/clipboard.ts
index c53a382b..9d40657c 100644
--- a/packages/coding-agent/src/utils/clipboard.ts
+++ b/packages/coding-agent/src/utils/clipboard.ts
@@ -23,15 +23,31 @@ function isRemoteSession(env: NodeJS.ProcessEnv = process.env): boolean {
 	return Boolean(env.SSH_CONNECTION || env.SSH_CLIENT || env.MOSH_CONNECTION);
 }
 
-function emitOsc52(text: string): boolean {
+/** OSC 52 clipboard target: `c` = CLIPBOARD (explicit copy), `s` = SELECTION (primary). */
+export type ClipboardTarget = "c" | "s";
+
+function emitOsc52(text: string, target: ClipboardTarget = "c"): boolean {
 	const encoded = Buffer.from(text).toString("base64");
 	if (encoded.length > MAX_OSC52_ENCODED_LENGTH) {
 		return false;
 	}
-	process.stdout.write(`\x1b]52;c;${encoded}\x07`);
+	process.stdout.write(`\x1b]52;${target};${encoded}\x07`);
 	return true;
 }
 
+/**
+ * Optional clipboard read transport provided by the host TUI (OSC 52 via the
+ * outer terminal). Used as a last resort when no local clipboard tooling is
+ * available, e.g. inside a sandbox without X11/Wayland access.
+ */
+let terminalClipboardReader: ((target: ClipboardTarget) => Promise<string | null>) | null = null;
+
+export function setTerminalClipboardReader(
+	reader: ((target: ClipboardTarget) => Promise<string | null>) | null,
+): void {
+	terminalClipboardReader = reader;
+}
+
 type ClipboardReadResult = { ok: true; text: string | null } | { ok: false };
 
 const READ_CLIPBOARD_OPTIONS: ExecFileSyncOptionsWithStringEncoding = {
@@ -40,37 +56,49 @@ const READ_CLIPBOARD_OPTIONS: ExecFileSyncOptionsWithStringEncoding = {
 	timeout: 5000,
 };
 
-function readWaylandClipboardText(): ClipboardReadResult {
+function readWaylandClipboardText(target: ClipboardTarget): ClipboardReadResult {
+	const args = ["--no-newline", "--type", "text"];
+	if (target === "s") args.push("--selection", "primary");
 	try {
-		const text = execFileSync("wl-paste", ["--no-newline", "--type", "text"], READ_CLIPBOARD_OPTIONS);
+		const text = execFileSync("wl-paste", args, READ_CLIPBOARD_OPTIONS);
 		return { ok: true, text: text || null };
 	} catch {
 		return { ok: false };
 	}
 }
 
-/** Read plain text from the system clipboard. */
-export async function readClipboardText(): Promise<string | null> {
+/** Read plain text from the system clipboard (or primary selection). */
+export async function readClipboardText(target: ClipboardTarget = "c"): Promise<string | null> {
 	if (platform() === "linux" && isWaylandSession() && process.env.WAYLAND_DISPLAY) {
-		const result = readWaylandClipboardText();
+		const result = readWaylandClipboardText(target);
 		if (result.ok) {
 			return result.text;
 		}
 	}
 
-	if (!clipboard) {
-		return null;
+	// The native addon only exposes the regular clipboard.
+	if (target === "c" && clipboard) {
+		try {
+			const text = await clipboard.getText();
+			if (text) return text;
+		} catch {
+			// Fall through to the terminal transport.
+		}
 	}
 
-	try {
-		const text = await clipboard.getText();
-		return text || null;
-	} catch {
-		return null;
+	if (terminalClipboardReader) {
+		try {
+			const text = (await terminalClipboardReader(target)) || null;
+			return text;
+		} catch {
+			// Terminal transport is best-effort.
+		}
 	}
+
+	return null;
 }
 
-export async function copyToClipboard(text: string): Promise<void> {
+export async function copyToClipboard(text: string, target: ClipboardTarget = "c"): Promise<void> {
 	let copied = false;
 
 	const p = platform();
@@ -165,7 +193,7 @@ export async function copyToClipboard(text: string): Promise<void> {
 	}
 
 	if (remote || !copied) {
-		const osc52Copied = emitOsc52(text);
+		const osc52Copied = emitOsc52(text, target);
 		copied = copied || osc52Copied;
 	}
 
