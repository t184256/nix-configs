-function emitOsc52(text: string): boolean {
+/** OSC 52 clipboard target: `c` = CLIPBOARD (explicit copy), `s` = SELECTION (primary). */
+export type ClipboardTarget = "c" | "s";
+
+function emitOsc52(text: string, target: ClipboardTarget = "c"): boolean {
 	const encoded = Buffer.from(text).toString("base64");
 	if (encoded.length > MAX_OSC52_ENCODED_LENGTH) {
 		return false;
 	}
-	process.stdout.write(`\x1b]52;c;${encoded}\x07`);
+	process.stdout.write(`\x1b]52;${target};${encoded}\x07`);
 	return true;
 }
 
+/**
+ * Optional clipboard read transport provided by the host TUI (OSC 52 via the
+ * outer terminal). Used as a last resort when no local clipboard tooling is
+ * available, e.g. inside a sandbox without X11/Wayland access.
+ */
+let terminalClipboardReader: ((target: ClipboardTarget) => Promise<string | null>) | null = null;
+
+export function setTerminalClipboardReader(
+	reader: ((target: ClipboardTarget) => Promise<string | null>) | null,
+): void {
+	terminalClipboardReader = reader;
+}
