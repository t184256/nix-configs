+	/**
+	 * Request the terminal's system clipboard via an OSC 52 query.
+	 *
+	 * Resolves with the clipboard text, or null if the terminal does not answer
+	 * within the timeout. Used as a fallback when no local clipboard tooling is
+	 * available (e.g. inside a sandbox without X11/Wayland access).
+	 */
+	requestOsc52Clipboard(target: "c" | "s" = "c", timeoutMs = 1000): Promise<string | null> {
+		return new Promise((resolve) => {
+			const entry = {
+				resolve: (text: string | null) => resolve(text),
+				timer: setTimeout(() => {
+					this.settleOsc52ClipboardReads(null);
+				}, timeoutMs),
+			};
+			this.pendingOsc52ClipboardReads.push(entry);
+			this.terminal.write(`\x1b]52;${target};?\x07`);
+		});
+	}
+
+	private settleOsc52ClipboardReads(text: string | null): void {
+		const pending = this.pendingOsc52ClipboardReads;
+		this.pendingOsc52ClipboardReads = [];
+		for (const entry of pending) {
+			clearTimeout(entry.timer);
+			entry.resolve(text);
+		}
+	}
+
+	private consumeOsc52ClipboardResponse(data: string): boolean {
+		if (this.pendingOsc52ClipboardReads.length === 0) return false;
+		const match = data.match(/^\x1b\]52;[cs];([A-Za-z0-9+/=]*)(?:\x07|\x1b\\)$/);
+		if (!match) return false;
+		this.settleOsc52ClipboardReads(Buffer.from(match[1] ?? "", "base64").toString("utf8"));
+		return true;
+	}
+
 	private consumeCellSizeResponse(data: string): boolean {
 		// Response format: ESC [ 6 ; height ; width t
 		const match = data.match(/^\x1b\[6;(\d+);(\d+)t$/);
