From 6f8cef23c12b9694ab22a7b864fcc81819624834 Mon Sep 17 00:00:00 2001
From: Alexander Sosedkin <monk@unboiled.info>
Date: Mon, 27 Jul 2026 19:05:16 +0000
Subject: [PATCH] Show completion duration in bash tool output

---
 packages/coding-agent/src/core/tools/bash.ts | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/packages/coding-agent/src/core/tools/bash.ts b/packages/coding-agent/src/core/tools/bash.ts
index 4fdae2ca..76d18ae6 100644
--- a/packages/coding-agent/src/core/tools/bash.ts
+++ b/packages/coding-agent/src/core/tools/bash.ts
@@ -54,6 +54,7 @@ export type BashToolInput = Static<typeof bashSchema>;
 export interface BashToolDetails {
 	truncation?: TruncationResult;
 	fullOutputPath?: string;
+	hasCompletionMessage?: boolean;
 }
 
 /**
@@ -318,7 +319,7 @@ function rebuildBashResultRenderComponent(
 		component.addChild(new Text(theme.fg("warning", `[${warnings.join(". ")}]`), 0, 0));
 	}
 
-	if (startedAt !== undefined) {
+	if (startedAt !== undefined && !result.details?.hasCompletionMessage) {
 		const label = options.isPartial ? "Elapsed" : "Took";
 		const endTime = endedAt ?? Date.now();
 		component.addChild(new Text(theme.fg("muted", `${label} ${formatDuration(endTime - startedAt)}`), 0, 0));
@@ -446,6 +447,7 @@ export function createShellToolDefinition(
 			const appendStatus = (text: string, status: string) => `${text ? `${text}` : ""}[${status}]`;
 
 			try {
+				const startedAt = Date.now();
 				let exitCode: number | null;
 				try {
 					const result = await ops.exec(spawnContext.command, spawnContext.cwd, {
@@ -473,7 +475,10 @@ export function createShellToolDefinition(
 				if (exitCode !== 0 && exitCode !== null) {
 					throw new Error(appendStatus(outputText, `Command exited with code ${exitCode}`));
 				}
-				return { content: [{ type: "text", text: outputText }], details };
+				return {
+					content: [{ type: "text", text: appendStatus(outputText, `Command completed successfully in ${formatDuration(Date.now() - startedAt)}`) }],
+					details: { ...details, hasCompletionMessage: true },
+				};
 			} finally {
 				clearUpdateTimer();
 			}
-- 
2.55.0

