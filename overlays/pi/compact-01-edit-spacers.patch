From 4d87da3aaa2c02fa931a79a1bb44a40af147d127 Mon Sep 17 00:00:00 2001
From: Alexander Sosedkin <monk@unboiled.info>
Date: Fri, 19 Jun 2026 21:37:29 +0000
Subject: [PATCH 01/24] src/core/tools/renderers/edit: remove spacers

---
 packages/coding-agent/src/core/tools/renderers/edit.ts | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/packages/coding-agent/src/core/tools/renderers/edit.ts b/packages/coding-agent/src/core/tools/renderers/edit.ts
index f4d1df6dd..b70e509f0 100644
--- a/packages/coding-agent/src/core/tools/renderers/edit.ts
+++ b/packages/coding-agent/src/core/tools/renderers/edit.ts
@@ -6,7 +6,7 @@
  * definition, so the tool's public shape is unchanged.
  */
 
-import { Box, Container, Spacer, Text } from "@earendil-works/pi-tui";
+import { Box, Container, Text } from "@earendil-works/pi-tui";
 import { renderDiff } from "../../../modes/interactive/components/diff.ts";
 import type { Theme } from "../../../modes/interactive/theme/theme.ts";
 import type { ToolDefinition } from "../../extensions/types.ts";
@@ -146,7 +146,7 @@ function buildEditCallComponent(
 
 	const body =
 		"error" in component.preview ? theme.fg("error", component.preview.error) : renderDiff(component.preview.diff);
-	component.addChild(new Spacer(1));
+	// no spacer
 	component.addChild(new Text(body, 0, 0));
 	return component;
 }
@@ -245,7 +245,7 @@ export const editRenderers: Pick<ToolDefinition<any, any>, "renderCall" | "rende
 		if (!output) {
 			return component;
 		}
-		component.addChild(new Spacer(1));
+		// no spacer
 		component.addChild(new Text(output, context.outputPad, 0));
 		return component;
 	},
-- 
