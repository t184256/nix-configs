From 60ea1674857e1c290ae41751490b2fb0be54531f Mon Sep 17 00:00:00 2001
From: Alexander Sosedkin <monk@unboiled.info>
Date: Sat, 20 Jun 2026 01:06:22 +0000
Subject: [PATCH 14/24] tui: remove editor borders

---
 packages/tui/src/components/editor.ts | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/packages/tui/src/components/editor.ts b/packages/tui/src/components/editor.ts
index c7fda44..e00ac61 100644
--- a/packages/tui/src/components/editor.ts
+++ b/packages/tui/src/components/editor.ts
@@ -508,13 +508,15 @@ export class Editor implements Component, Focusable {
 	}
 
 	protected renderTopBorder(width: number, hiddenLineCount: number): string {
-		const border = hiddenLineCount > 0 ? createScrollBorder("↑", hiddenLineCount, width) : "─".repeat(width);
-		return this.borderColor(border);
+		// no top border
+		if (hiddenLineCount === 0) return "";
+		return this.borderColor(createScrollBorder("↑", hiddenLineCount, width));
 	}
 
 	protected renderBottomBorder(width: number, hiddenLineCount: number): string {
-		const border = hiddenLineCount > 0 ? createScrollBorder("↓", hiddenLineCount, width) : "─".repeat(width);
-		return this.borderColor(border);
+		// no bottom border
+		if (hiddenLineCount === 0) return "";
+		return this.borderColor(createScrollBorder("↓", hiddenLineCount, width));
 	}
 
 	render(width: number): string[] {
@@ -560,7 +562,8 @@ export class Editor implements Component, Focusable {
 		const rightPadding = leftPadding;
 
 		// Render top border (with scroll indicator if scrolled down)
-		result.push(this.renderTopBorder(width, this.scrollOffset));
+		const topBorder = this.renderTopBorder(width, this.scrollOffset);
+		if (topBorder !== "") result.push(topBorder);
 
 		// Render each visible layout line
 		// Emit hardware cursor marker when focused so TUI can position the
@@ -612,7 +615,8 @@ export class Editor implements Component, Focusable {
 
 		// Render bottom border (with scroll indicator if more content below)
 		const linesBelow = layoutLines.length - (this.scrollOffset + visibleLines.length);
-		result.push(this.renderBottomBorder(width, linesBelow));
+		const bottomBorder = this.renderBottomBorder(width, linesBelow);
+		if (bottomBorder !== "") result.push(bottomBorder);
 
 		// Add autocomplete list if active
 		this.renderedAutocompleteHeight = 0;
-- 
2.55.0

