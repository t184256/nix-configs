From 52d6f8556a4c72d395190646dd9ce1599f8c723e Mon Sep 17 00:00:00 2001
From: Alexander Sosedkin <monk@unboiled.info>
Date: Fri, 19 Jun 2026 22:55:50 +0000
Subject: [PATCH 09/24] tools: remove leading newlines

---
 packages/coding-agent/src/core/tools/bash.ts           | 2 +-
 packages/coding-agent/src/core/tools/renderers/bash.ts | 6 +++---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/packages/coding-agent/src/core/tools/bash.ts b/packages/coding-agent/src/core/tools/bash.ts
index 8e058b9b6..dcc93d40c 100644
--- a/packages/coding-agent/src/core/tools/bash.ts
+++ b/packages/coding-agent/src/core/tools/bash.ts
@@ -357,7 +357,7 @@ export function createShellToolDefinition(
 				return { text, details };
 			};
 
-			const appendStatus = (text: string, status: string) => `${text ? `${text}\n\n` : ""}${status}`;
+			const appendStatus = (text: string, status: string) => `${text ? `${text}` : ""}[${status}]`;
 			const startedAt = performance.now();
 
 			try {
diff --git a/packages/coding-agent/src/core/tools/renderers/bash.ts b/packages/coding-agent/src/core/tools/renderers/bash.ts
index 8bc8687f6..b613bb5d3 100644
--- a/packages/coding-agent/src/core/tools/renderers/bash.ts
+++ b/packages/coding-agent/src/core/tools/renderers/bash.ts
@@ -69,7 +69,7 @@ function rebuildBashResultRenderComponent(
 		const styledOutput = lines.join("\n");
 
 		if (options.expanded) {
-			component.addChild(new Text(`\n${styledOutput}`, 0, 0));
+			component.addChild(new Text(styledOutput, 0, 0));
 		} else {
 			component.addChild(new Spacer(1));
 			component.addChild(
@@ -99,7 +99,7 @@ function rebuildBashResultRenderComponent(
 				);
 			}
 		}
-		component.addChild(new Text(`\n${theme.fg("warning", `[${warnings.join(". ")}]`)}`, 0, 0));
+		component.addChild(new Text(theme.fg("warning", `[${warnings.join(". ")}]`), 0, 0));
 	}
 
 	// A final result's recorded duration wins: it is monotonic and survives reloads. The renderer's own clock is the
@@ -116,7 +116,7 @@ function rebuildBashResultRenderComponent(
 	} else if (startedAt !== undefined) {
 		const label = options.isPartial ? "Elapsed" : "Took";
 		const endTime = endedAt ?? Date.now();
-		component.addChild(new Text(`\n${theme.fg("muted", `${label} ${formatDuration(endTime - startedAt)}`)}`, 0, 0));
+		component.addChild(new Text(theme.fg("muted", `${label} ${formatDuration(endTime - startedAt)}`), 0, 0));
 	}
 }
 
-- 
2.55.0

