From 414bf059d8b5bbdcbec326960fdc741afae29f52 Mon Sep 17 00:00:00 2001
From: Alexander Sosedkin <monk@unboiled.info>
Date: Mon, 27 Jul 2026 18:56:28 +0000
Subject: [PATCH 16/24] modes/interactive/components/assistant-message: remove
 spacers

---
 .../interactive/components/assistant-message.ts      | 20 +++++---------------
 1 file changed, 5 insertions(+), 15 deletions(-)

diff --git a/packages/coding-agent/src/modes/interactive/components/assistant-message.ts b/packages/coding-agent/src/modes/interactive/components/assistant-message.ts
index 7cb29603..3162b6b7 100644
--- a/packages/coding-agent/src/modes/interactive/components/assistant-message.ts
+++ b/packages/coding-agent/src/modes/interactive/components/assistant-message.ts
@@ -5,7 +5,6 @@ import {
 	Markdown,
 	type MarkdownTheme,
 	MouseRegion,
-	Spacer,
 	Text,
 } from "@earendil-works/pi-tui";
 import type { MarkdownTransformer } from "../../../core/extensions/types.ts";
@@ -130,15 +129,8 @@ export class AssistantMessageComponent extends Container {
 			return markdown;
 		};
 
-		// Spacers are added lazily, right before the next visible content block. This puts a blank
-		// line before the first visible block and after each visible thinking run that is followed
-		// by more visible content, while hidden thinking runs without a label contribute nothing.
-		let needsSpacer = true;
 		const addVisibleChild = (child: Component) => {
-			if (needsSpacer) {
-				this.contentContainer.addChild(new Spacer(1));
-				needsSpacer = false;
-			}
+			// no spacer
 			this.contentContainer.addChild(child);
 		};
 
@@ -225,9 +217,7 @@ export class AssistantMessageComponent extends Container {
 						return { handled: true };
 					}),
 				);
-				// Add spacing only when another visible assistant content block follows.
-				// This avoids a superfluous blank line before separately-rendered tool execution blocks.
-				needsSpacer = true;
+				// no spacer
 			}
 		}
 
@@ -237,7 +227,7 @@ export class AssistantMessageComponent extends Container {
 		const hasToolCalls = message.content.some((c) => c.type === "toolCall");
 		this.hasToolCalls = hasToolCalls;
 		if (message.stopReason === "length") {
-			this.contentContainer.addChild(new Spacer(1));
+			// no spacer
 			this.contentContainer.addChild(
 				new Text(theme.fg("error", "Response was truncated before completion."), this.outputPad, 0),
 			);
@@ -247,11 +237,11 @@ export class AssistantMessageComponent extends Container {
 					message.errorMessage && message.errorMessage !== "Request was aborted"
 						? message.errorMessage
 						: "Operation aborted";
-				this.contentContainer.addChild(new Spacer(1));
+				// no spacer
 				this.contentContainer.addChild(new Text(theme.fg("error", abortMessage), this.outputPad, 0));
 			} else if (message.stopReason === "error") {
 				const errorMsg = message.errorMessage || "Unknown error";
-				this.contentContainer.addChild(new Spacer(1));
+				// no spacer
 				this.contentContainer.addChild(new Text(theme.fg("error", `Error: ${errorMsg}`), this.outputPad, 0));
 			}
 		}
-- 
